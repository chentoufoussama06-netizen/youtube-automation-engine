# Runtime job state, regenerated by scripts/seed-queue.js
data/queue.json

# Every per-channel OAuth token, not just the default one.
# tokens.clips.json and tokens.aftercache.json were untracked but NOT ignored,
# so a single `git add -A` would have committed two channels refresh tokens.
config/tokens*.json

# media, caches and renders live outside git; ledgers live in state/
data/
state/**/video/
state/**/audio/
state/**/captions/
state/**/work/
state/**/videos/
state/**/production/
state/**/thumbnails/
